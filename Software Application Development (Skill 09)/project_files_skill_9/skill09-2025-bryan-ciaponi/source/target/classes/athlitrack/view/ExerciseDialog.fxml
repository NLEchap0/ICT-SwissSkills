<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- Dialogo modale aggiungi/modifica esercizio (dimensione fissa, si salva solo con Salva). -->
<!-- Il ComboBox è editabile: suggerisce i tipi ma accetta anche testo libero. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="athlitrack.controller.ExerciseDialogController"
      spacing="6" prefWidth="430" prefHeight="330"
      styleClass="view" stylesheets="@app.css">
    <Label text="Name:"/>
    <TextField fx:id="nameField"/>
    <Label text="Description:"/>
    <TextField fx:id="descriptionField"/>
    <Label text="Type:"/>
    <ComboBox fx:id="typeBox" editable="true" maxWidth="Infinity"/>
    <Label fx:id="error" styleClass="error-label" wrapText="true"/>
    <HBox spacing="8">
        <Button text="Save" defaultButton="true" onAction="#onSave"/>
        <Button text="Cancel" cancelButton="true" onAction="#onCancel"/>
    </HBox>
</VBox>
