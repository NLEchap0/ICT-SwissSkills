<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- Finestra iniziale: lista dei workout creati (nome, inizio, fine, durata). -->
<!-- Le colonne inizio/fine/durata sono calcolate nel controller (MainController). -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="athlitrack.controller.MainController"
      spacing="8" styleClass="view" stylesheets="@app.css">
    <Label text="Workouts" styleClass="view-title"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Workout name" prefWidth="230">
                <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="startColumn" text="Start" prefWidth="150"/>
            <TableColumn fx:id="endColumn" text="End" prefWidth="150"/>
            <TableColumn fx:id="durationColumn" text="Duration" prefWidth="110"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button text="Add Workout" onAction="#onAdd"/>
        <Button text="Edit Workout" onAction="#onEdit"/>
        <Button text="View Workout" onAction="#onView"/>
        <Button text="Delete" onAction="#onDelete"/>
    </HBox>
</VBox>
