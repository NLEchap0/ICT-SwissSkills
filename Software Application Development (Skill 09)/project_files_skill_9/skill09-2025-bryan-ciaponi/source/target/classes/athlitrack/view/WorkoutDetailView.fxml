<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- Pagina di sola lettura "Workout ..." con statistiche e scorciatoia ai progressi. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="athlitrack.controller.WorkoutDetailController"
      spacing="8" styleClass="view" stylesheets="@app.css">
    <Label fx:id="title" text="Workout" styleClass="view-title"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Exercise" prefWidth="260">
                <cellValueFactory><PropertyValueFactory property="exercise"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Set" prefWidth="70">
                <cellValueFactory><PropertyValueFactory property="set"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Weight (kg)" prefWidth="110">
                <cellValueFactory><PropertyValueFactory property="weight"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Reps" prefWidth="90">
                <cellValueFactory><PropertyValueFactory property="reps"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
    <Label fx:id="stats" styleClass="stats-label"/>
    <HBox spacing="8">
        <Label text="Exercise:"/>
        <ComboBox fx:id="exerciseBox"/>
        <Button text="My Progress" onAction="#onProgress"/>
        <Button text="Back" onAction="#onBack"/>
    </HBox>
</VBox>
