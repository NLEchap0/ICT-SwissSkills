<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.gestioneutenti.controller.userController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <GridPane alignment="CENTER" hgap="10" vgap="10">
        <!-- Riga 1 -->
        <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Insert your name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- Riga 2 -->
        <Label text="Surname:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="surnameField" promptText="Insert your surname" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <Button text="Save User" onAction="#onButtonClickAddUser"/>
    <Label fx:id="statusMessage"/>

    <TableView fx:id="userTable">
        <columns>
            <TableColumn fx:id="colName" text="Name" prefWidth="300"/>
            <TableColumn fx:id="colSurname" text="Surname" prefWidth="300"/>
        </columns>
    </TableView>
</VBox>
